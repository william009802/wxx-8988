# ---- storage -------------------------------------------------------------
# On Railway: add a Volume to the service and set its mount path to /data.
# Without one, /data is ordinary container filesystem: every write succeeds,
# nothing errors, and the entire database is destroyed by the next deploy. The
# bot now refuses to start rather than collect two weeks of data onto disposable
# storage -- that is what REQUIRE_DURABLE_DB is for. Set it false for local runs
# only, where a throwaway database is the point.
DB_PATH=/data/wxalpha.db
REQUIRE_DURABLE_DB=true

# Retention is sized for a free-tier volume. Everything that the end-of-run
# analysis reads is kept for the whole run; what ages out is the raw book tick
# for the ~900 markets we only watch, and those are averaged into quotes_hourly
# before deletion. Trades, settlements, resolutions, mark_ticks and
# settled_highs are never pruned at any age.
QUOTE_RETENTION_H=6      # raw ticks, all markets. The bulk of the file.
FORECAST_RETENTION_D=45  # must outlast the run: this is the bias measurement
SIGNAL_RETENTION_D=3     # untaken signals only; taken ones are kept forever
EQUITY_RETENTION_D=90
LOG_ROWS=3000
MAX_DB_MB=400            # warns at 75%, errors past this, VACUUMs to stay under
VACUUM_EVERY_H=12

# Price track for markets we actually hold, which is what makes the "would
# cashing out early have been better" question answerable afterwards. One row
# per held market every MARK_EVERY_S, or sooner if the mid moves this far.
MARK_EVERY_S=300
MARK_MIN_MOVE=0.005

# Export: stored uncompressed so the archive opens straight into Excel/pandas
# with no unpacking step. Set true only if you are downloading over a slow link.
EXPORT_COMPRESS=false

# ---- execution -----------------------------------------------------------
LIVE_TRADING=false
START_BANKROLL=800      # split evenly across the strategies
POLL_SECONDS=45
DAILY_LOSS_LIMIT=0.12
SLIPPAGE=0.005
MIN_SHARES=5            # Polymarket rejects orders smaller than this

# ---- settlement ----------------------------------------------------------
# A market only settles on Polymarket's own resolution, and only when its
# outcomePrices have converged past this. Anything less decisive is left open
# and re-checked. A recorded temperature can no longer settle anything at all.
SETTLE_MIN_CONVICTION=0.95
# Markets Polymarket never resolves are retired from the live set after this
# many hours past their close, with no winner invented and nothing booked.
STALE_MARKET_H=72

# ---- health --------------------------------------------------------------
# /health returns 503 once the trading loop has not ticked for this long, so
# Railway's healthcheck restarts a wedged asyncio loop instead of watching a
# dead bot report itself healthy for two weeks. Also the startup grace period.
HEALTH_MAX_TICK_AGE_S=900

# ---- polymarket (only needed when LIVE_TRADING=true) ---------------------
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_SIG_TYPE=1

# ---- weather -------------------------------------------------------------
USER_AGENT=wxalpha/1.0 (you@example.com)

# Station bias in degrees F: forecast gridpoint minus the station Polymarket
# actually resolves on. LEAVE THESE AT ZERO FOR THE OBSERVATION RUN.
#
# They are the single most valuable thing the run will produce, and setting them
# from two or three days of data would fit the bot to noise and destroy the
# out-of-sample value of the very run that is meant to measure them. Fill them
# in afterwards, from resolutions joined to forecasts across the whole window,
# then re-run a shorter confirmation period before any real money.
#
# A non-zero value here also acts as a flag meaning "this city has been
# measured", which is one of the gates S6 requires.
BIAS_NYC=0
BIAS_LON=0
